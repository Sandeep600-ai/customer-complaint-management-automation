            {
              "name": "customer_name",
              "description": "Extract the customer's full name from the email. The customer's name is usually found in the signature or greeting. Always return the customer's name if it is present in the email. If no name is present, return Unknown."
            },
            {
              "name": "customer_email",
              "description": "Extract the customer's email address from the email."
            },
            {
              "name": "complaint",
              "description": "Summarize the customer's complaint clearly in one sentence."
            },
            {
              "name": "complaint_type",
              "description": "Classify the complaint into exactly one of these categories: Delivery, Refund, Product, or Other. Delivery means delivery or late-order problems. Refund means refund or payment-related problems. Product means damaged, defective, wrong, or poor-quality product problems. Other means any complaint that does not fit these categories."
            },
            {
              "name": "order_id",
              "description": "Extract the order ID or order number from the email. If no order ID is mentioned, return Unknown."
            },
            {
              "name": "priority",
              "description": "Classify the complaint as High, Medium, or Low. Use High for serious issues such as damaged products, missing orders, or refund problems. Use Medium for normal complaints. Use Low for minor or general issues."
            }
